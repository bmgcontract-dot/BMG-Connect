# Firebase Auth is the safe default. Use legacy only for an intentional rollback.
VITE_AUTH_MODE=firebase
VITE_INTERNAL_AUTH_DOMAIN=auth.bmg-connect.local

# Set only on the retired bmg-connect-6b24 Vercel project when the recovery
# portal is ready for its controlled rollout. Leave unset for the main app.
# VITE_APP_MODE=legacy-recovery

# Server-only values for the Vercel admin-users function and migration script.
# Never prefix these with VITE_ and never commit their real values.
BMG_FIREBASE_PROJECT_ID=bmg-connect-3e99a
BMG_FIRESTORE_APP_ID=bmg-app-prod
BMG_INTERNAL_AUTH_DOMAIN=auth.bmg-connect.local
FIREBASE_SERVICE_ACCOUNT_JSON=

# Private Cloud Storage bucket used only for immutable legacy recovery snapshots.
# Configure this on the retired Vercel project before enabling uploads.
BMG_RECOVERY_BUCKET=

# Required only when intentionally running the applying migration command.
BMG_CONFIRM_PROJECT_ID=

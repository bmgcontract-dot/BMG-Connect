{
  "name": "bmg-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "test": "node --test tests/**/*.test.js",
    "test:rules": "firebase emulators:exec --only firestore \"node --test tests/firestore-rules/**/*.rules-test.js\"",
    "auth:migrate:dry-run": "node scripts/migrate-users-to-firebase-auth.mjs",
    "auth:migrate": "node scripts/migrate-users-to-firebase-auth.mjs --apply",
    "firestore:ownership:audit": "node scripts/audit-firestore-ownership.mjs",
    "schedule:migrate:dry-run": "node scripts/migrate-project-schedule-metadata.mjs",
    "schedule:migrate": "node scripts/migrate-project-schedule-metadata.mjs --apply",
    "preview": "vite preview"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "firebase-admin": "14.4.0",
    "lucide-react": "^0.378.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "vite": "^5.2.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.63.1"
  },
  "overrides": {
    "jose": "5.10.0"
  }
}
